FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      transportProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

phases          (water oil);

water
{
    transportModel  Newtonian;
    nu              1e-06;
    rho             998.2;
}

oil
{
    transportModel  Newtonian;
    nu              1e-05;
    rho             890.0;
}

sigma           0.03;

