FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.oil.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 2;
        cAlpha          1;
    }

    "(pcorr|pcorrFinal)"
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-04;
        relTol          0.01;
        maxIter         500;
    }

    p_rgh
    {
        solver          GAMG;
        tolerance       1e-05;
        relTol          0.05;
        smoother        DICGaussSeidel;
        nPreSweeps      0;
        nPostSweeps     2;
        cacheAgglomeration on;
        agglomerator    faceAreaPair;
        nCellsInCoarsestLevel 10;
        mergeLevels     1;
        maxIter         50;
    }

    p_rghFinal
    {
        $p_rgh;
        tolerance       1e-05;
        relTol          0;
        maxIter         50;
    }

    "U.*"
    {
        solver          PBiCGStab;
        preconditioner  DILU;
        tolerance       1e-06;
        relTol          0.1;
    }

    "(k|epsilon|omega|B|nuTilda).*"
    {
        solver          smoothSolver;
        smoother        GaussSeidel;
        nSweeps         1;
        tolerance       1e-06;
        relTol          0.1;
    }
}

PIMPLE
{
    momentumPredictor           yes;
    correctPhi                  yes;
    nOuterCorrectors            2;
    nCorrectors                 2;
    nNonOrthogonalCorrectors    0;

    residualControl
    {
        p_rgh
        {
            tolerance   5e-06;
            relTol      0;
        }
        "U.*"
        {
            tolerance   1e-05;
            relTol      0;
        }
    }
}

relaxationFactors
{
    fields
    {
        p_rgh           0.3;
        p_rghFinal      1;
    }

    equations
    {
        U               0.7;
        UFinal          1;
        k               0.7;
        kFinal          1;
        omega           0.7;
        omegaFinal      1;
        "alpha.oil.*"   1;  
    }
}
