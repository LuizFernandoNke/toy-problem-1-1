FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
writeControl    writeTime;
interpolationScheme cellPoint;
setFormat       raw;

sets
(
    // Perfil de velocidade transversal
    profile_mid
    {
        type            uniform;
        axis            y;
        start           (0 -0.02375 1.75);
        end             (0 0.02375 1.75);
        nPoints         100;
    }
    // Linha central para calcular Delta P ao longo de Z
    center_line
    {
        type            uniform;
        axis            z;
        start           (0 0 0.02);
        end             (0 0 1.98);
        nPoints         200;
    }
);

fields
(
    p_rgh
    U
);

