FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
writeControl    writeTime;
interpolationScheme cellPoint;
setFormat       raw;

sets
(
    profile_mid
    {
        type            uniform;
        axis            y;
        start           (0 -0.02375 1.75);
        end             (0 0.02375 1.75);
        nPoints         100;
    }

    center_line
    {
        type            uniform;
        axis            z;
        start           (0 0 1.2);
        end             (0 0 1.9);
        nPoints         100;
    }
);

fields
(
    p_rgh
    U
);

