FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

type            sets;
libs            ("libsampling.so");
setFormat       raw;

sets
{
    // Linha vertical para capturar o perfil de velocidade U no centro do domínio
    profile_mid
    {
        type        lineCell;
        axis        y;
        start       (0.5 0.0 0.005);
        end         (0.5 0.1 0.005);
    }

    // Linha horizontal no centro do canal para capturar a queda de pressão p_rgh
    center_line
    {
        type        lineCell;
        axis        x;
        start       (0.0 0.05 0.005);
        end         (1.0 0.05 0.005);
    }
}

fields          (U p_rgh p);

