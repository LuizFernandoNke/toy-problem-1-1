FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvOptions;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

limitNut
{
    type            limitTurbulenceViscosity;
    active          true;
    selectionMode   all;
    max             1e-3;
}

multiphaseStabilizedTurbulence
{
    type            multiphaseStabilizedTurbulence;
    active          true;

    multiphaseStabilizedTurbulenceCoeffs
    {
        alpha           0.05;
        lambda2         0.1;
    }
}

